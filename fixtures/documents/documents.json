[
  {
    "name": "document-backtick-fence-excludes-tasks",
    "content": "- [ ] Real task #task\n```\n- [ ] Fake task inside a fence #task\n```\n- [ ] Another real task #task\n",
    "expected": { "taskCount": 2 }
  },
  {
    "name": "document-tilde-fence-excludes-tasks",
    "content": "- [ ] Real task #task\n~~~\n- [ ] Fake task inside a fence #task\n~~~\n",
    "expected": { "taskCount": 1 }
  },
  {
    "name": "document-frontmatter-inline-array-tags",
    "content": "---\ntags: [work, personal/errands]\n---\n- [ ] Task #task\n",
    "expected": { "taskCount": 1, "frontmatterTags": ["#work", "#personal/errands"] }
  },
  {
    "name": "document-frontmatter-list-tags",
    "content": "---\ntags:\n  - work\n  - urgent\n---\n- [ ] Task #task\n",
    "expected": { "taskCount": 1, "frontmatterTags": ["#work", "#urgent"] }
  },
  {
    "name": "document-mixed-line-endings",
    "content": "- [ ] One #task\r\n- [ ] Two #task\n- [ ] Three #task\r\n",
    "expected": { "taskCount": 3 }
  },
  {
    "name": "document-missing-trailing-newline",
    "content": "- [ ] One #task\n- [ ] Two #task",
    "expected": { "taskCount": 2 }
  },
  {
    "name": "document-nested-subtasks",
    "content": "- [ ] Parent task #task\n\t- [ ] Child task #task\n",
    "expected": {
      "taskCount": 2,
      "tasks": [
        { "description": "Parent task", "indentDepth": 0 },
        { "description": "Child task", "indentDepth": 1 }
      ]
    }
  },
  {
    "name": "document-unterminated-frontmatter-treated-as-plain-text",
    "content": "---\ntags: [work]\n- [ ] Task #task\n",
    "expected": { "taskCount": 1, "frontmatterTags": [] }
  },
  {
    "name": "document-frontmatter-tag-inheritance-off-by-default",
    "content": "---\ntags: [work]\n---\n- [ ] Task #task\n",
    "expected": {
      "taskCount": 1,
      "tasks": [{ "allTags": [] }]
    }
  },
  {
    "name": "document-frontmatter-tag-inheritance-merges-when-enabled",
    "content": "---\ntags: [work, urgent]\n---\n- [ ] Task #task #home\n",
    "config": { "frontmatterTagInheritance": true },
    "expected": {
      "taskCount": 1,
      "tasks": [{ "allTags": ["#home", "#work", "#urgent"] }]
    }
  },
  {
    "name": "document-frontmatter-tag-inheritance-dedupes-case-insensitively",
    "content": "---\ntags: [Work]\n---\n- [ ] Task #task #work\n",
    "config": { "frontmatterTagInheritance": true },
    "expected": {
      "taskCount": 1,
      "tasks": [{ "allTags": ["#work"] }]
    }
  },
  {
    "name": "document-task-under-heading-has-parent-heading",
    "content": "# Groceries\n- [ ] Buy milk #task\n",
    "expected": {
      "taskCount": 1,
      "tasks": [{ "parentHeading": "Groceries" }]
    }
  },
  {
    "name": "document-task-before-any-heading-has-no-parent-heading",
    "content": "- [ ] Early task #task\n# Later heading\n- [ ] Late task #task\n",
    "expected": {
      "taskCount": 2,
      "tasks": [
        { "parentHeading": null },
        { "parentHeading": "Later heading" }
      ]
    }
  },
  {
    "name": "document-nested-headings-nearest-one-wins",
    "content": "# Outer\n## Inner\n- [ ] Task #task\n",
    "expected": {
      "taskCount": 1,
      "tasks": [{ "parentHeading": "Inner" }]
    }
  },
  {
    "name": "document-heading-inside-fence-is-not-a-heading",
    "content": "```\n# Not a heading\n```\n- [ ] Task #task\n",
    "expected": {
      "taskCount": 1,
      "tasks": [{ "parentHeading": null }]
    }
  },
  {
    "name": "document-heading-with-closing-hash-sequence",
    "content": "## Heading ##\n- [ ] Task #task\n",
    "expected": {
      "taskCount": 1,
      "tasks": [{ "parentHeading": "Heading" }]
    }
  },
  {
    "name": "document-heading-trailing-whitespace-is-trimmed",
    "content": "# Heading with trailing spaces   \n- [ ] Task #task\n",
    "expected": {
      "taskCount": 1,
      "tasks": [{ "parentHeading": "Heading with trailing spaces" }]
    }
  },
  {
    "name": "document-seven-hashes-is-not-a-heading",
    "content": "####### Not a heading, too many hashes\n- [ ] Task #task\n",
    "expected": {
      "taskCount": 1,
      "tasks": [{ "parentHeading": null }]
    }
  }
]
