[
  {
    "name": "mutation-set-due-inserts-field",
    "input": "- [ ] Buy milk #task",
    "mutations": [{ "op": "setDue", "value": "2026-09-01" }],
    "expectedSerialized": "- [ ] Buy milk #task 📅 2026-09-01"
  },
  {
    "name": "mutation-set-due-replaces-existing-value-only",
    "input": "- [ ] Buy milk #task 📅 2026-08-13 🔺",
    "mutations": [{ "op": "setDue", "value": "2026-09-01" }],
    "expectedSerialized": "- [ ] Buy milk #task 📅 2026-09-01 🔺"
  },
  {
    "name": "mutation-remove-due",
    "input": "- [ ] Buy milk #task 📅 2026-08-13",
    "mutations": [{ "op": "setDue", "value": null }],
    "expectedSerialized": "- [ ] Buy milk #task"
  },
  {
    "name": "mutation-set-priority-inserts-marker",
    "input": "- [ ] Buy milk #task",
    "mutations": [{ "op": "setPriority", "value": "high" }],
    "expectedSerialized": "- [ ] Buy milk #task ⏫"
  },
  {
    "name": "mutation-set-priority-normal-removes-leading-marker-without-double-space",
    "input": "- [ ] 🔺 Buy milk #task",
    "mutations": [{ "op": "setPriority", "value": "normal" }],
    "expectedSerialized": "- [ ] Buy milk #task"
  },
  {
    "name": "mutation-add-tag",
    "input": "- [ ] Buy milk #task",
    "mutations": [{ "op": "addTag", "value": "#errands" }],
    "expectedSerialized": "- [ ] Buy milk #task #errands"
  },
  {
    "name": "mutation-add-tag-is-case-insensitive-dedupe-noop",
    "input": "- [ ] Buy milk #task #errands",
    "mutations": [{ "op": "addTag", "value": "#Errands" }],
    "expectedSerialized": "- [ ] Buy milk #task #errands"
  },
  {
    "name": "mutation-remove-tag",
    "input": "- [ ] Buy milk #task #errands",
    "mutations": [{ "op": "removeTag", "value": "#errands" }],
    "expectedSerialized": "- [ ] Buy milk #task"
  },
  {
    "name": "mutation-set-status-complete",
    "input": "- [ ] Buy milk #task",
    "mutations": [{ "op": "setStatus", "value": "x" }],
    "expectedSerialized": "- [x] Buy milk #task"
  },
  {
    "name": "mutation-set-description-replaces-leading-text-only",
    "input": "- [ ] Buy milk #task 📅 2026-08-13",
    "mutations": [{ "op": "setDescription", "value": "Buy oat milk" }],
    "expectedSerialized": "- [ ] Buy oat milk #task 📅 2026-08-13"
  },
  {
    "name": "mutation-sequential-status-then-tag",
    "input": "- [ ] Buy milk #task",
    "mutations": [
      { "op": "setStatus", "value": "x" },
      { "op": "addTag", "value": "#done-early" }
    ],
    "expectedSerialized": "- [x] Buy milk #task #done-early"
  },
  {
    "name": "mutation-set-recurrence-inserts-field",
    "input": "- [ ] Water plants #task 📅 2026-08-13",
    "mutations": [{ "op": "setRecurrence", "value": "every week" }],
    "expectedSerialized": "- [ ] Water plants #task 📅 2026-08-13 🔁 every week"
  },
  {
    "name": "mutation-set-recurrence-replaces-existing-value-only",
    "input": "- [ ] Water plants #task 🔁 every week 📅 2026-08-13",
    "mutations": [{ "op": "setRecurrence", "value": "every 2 weeks" }],
    "expectedSerialized": "- [ ] Water plants #task 🔁 every 2 weeks 📅 2026-08-13"
  },
  {
    "name": "mutation-remove-recurrence",
    "input": "- [ ] Water plants #task 🔁 every week",
    "mutations": [{ "op": "setRecurrence", "value": null }],
    "expectedSerialized": "- [ ] Water plants #task"
  },
  {
    "name": "mutation-set-reminder-inserts-field-with-time",
    "input": "- [ ] Standup #task",
    "mutations": [{ "op": "setReminder", "value": "2026-08-19 20:15" }],
    "expectedSerialized": "- [ ] Standup #task ⏰ 2026-08-19 20:15"
  },
  {
    "name": "mutation-set-reminder-replaces-existing-value-only",
    "input": "- [ ] Standup #task ⏰ 2026-08-19 20:15 🔺",
    "mutations": [{ "op": "setReminder", "value": "2026-08-20 09:00" }],
    "expectedSerialized": "- [ ] Standup #task ⏰ 2026-08-20 09:00 🔺"
  },
  {
    "name": "mutation-remove-reminder",
    "input": "- [ ] Standup #task ⏰ 2026-08-19 20:15",
    "mutations": [{ "op": "setReminder", "value": null }],
    "expectedSerialized": "- [ ] Standup #task"
  },
  {
    "name": "mutation-set-recurrence-keeps-trailing-zero-width-no-break-space",
    "input": "- [ ] Buy milk #task 🔁 every week \uFEFF ⏰ 2026-08-13",
    "mutations": [{ "op": "setRecurrence", "value": "every month" }],
    "expectedSerialized": "- [ ] Buy milk #task 🔁 every month \uFEFF ⏰ 2026-08-13"
  }
]
